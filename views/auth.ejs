<!doctype html>
<html lang="fr">

<head> 
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inscription / Connexion</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/main.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body class="gh-page" data-initial-mode="<%= typeof initialMode !== 'undefined' ? initialMode : 'login' %>">

    <%- include('partials/navbar', { user: currentUser }) %>

    <header class="gh-auth-banner">
      <div class="container py-5 text-white text-center">
        <h1 class="display-4 font-weight-bold mb-3">
          <%= initialMode === 'register' ? "Créer un compte" : "Se connecter" %>
        </h1>
        <p class="lead mb-0 gh-auth-banner-subtitle">
          <%= initialMode === 'register'
            ? "Rejoignez la communauté et commencez à jouer en quelques minutes."
            : "Accédez à votre espace pour reprendre vos parties." %>
        </p>
      </div>
    </header>

    <main class="container gh-auth-page py-5">
      <div class="gh-auth-shell mx-auto">
        <div id="status_message" class="alert d-none" role="alert"></div>

        <section class="gh-auth-card">
          <% const availableGames = Array.isArray(games) ? games : []; %>
          <form id="form_login" method="post" action="/connexion" hidden>
            <h2 class="h3 mb-4 text-center">Connexion</h2>

            <div class="form-group">
              <label for="login_identifiant">Email ou identifiant</label>
              <input type="text" id="login_identifiant" name="identifiant" class="form-control" required>
            </div>

            <div class="form-group">
              <label for="login_pswd">Mot de passe</label>
              <input type="password" id="login_pswd" name="mot_de_passe" class="form-control" required>
            </div>

            <div id="div_mdp_login" class="form-group form-check mb-4">
              <input type="checkbox" id="affiche_mdp_login" class="form-check-input">
              <label for="affiche_mdp_login" class="form-check-label">Afficher mot de passe</label>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Se connecter</button>
          </form>

          <form id="form_register" method="post" action="/inscription" hidden>
            <h2 class="h3 mb-4 text-center">Formulaire d'inscription</h2>

            <div class="form-group">
              <label for="username">Username</label>
              <input type="text" id="username" name="username" class="form-control" required>
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" class="form-control" required>
            </div>

            <div class="form-group">
              <label for="date">Date de naissance</label>
              <input type="date" id="date" name="date_naissance" class="form-control" required>
            </div>

            <div class="form-group">
              <label for="pswd1">Mot de passe</label>
              <input type="password" id="pswd1" name="mot_de_passe" class="form-control" required>
            </div>

            <div class="form-group">
              <label for="pswd2">Confirmer le mot de passe</label>
              <input type="password" id="pswd2" name="mot_de_passe_confirm" class="form-control" required>
            </div>

            <div class="form-group">
              <label>Jeux préférés</label>
              <% if (availableGames.length) { %>
                <% availableGames.forEach(function (game) { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="preferences[]" id="game_<%= game.id %>" value="<%= game.id %>">
                    <label class="form-check-label" for="game_<%= game.id %>"><%= game.name %></label>
                  </div>
                <% }); %>
              <% } else { %>
                <small class="form-text text-muted">Aucun jeu disponible.</small>
              <% } %>
            </div>

            <div id="div_mdp_register" class="form-group form-check mb-4">
              <input type="checkbox" id="affiche_mdp_register" class="form-check-input">
              <label for="affiche_mdp_register" class="form-check-label">Afficher mot de passe</label>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between">
              <button type="reset" class="btn btn-outline-secondary mb-2 mb-sm-0">Réinitialiser</button>
              <button type="submit" class="btn btn-primary">S'inscrire</button>
            </div>
          </form>
        </section>
      </div>
    </main>

    <script src="/js/auth_forms.js"></script>
    <script src="/js/navbar.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>

     </body>
</html> 