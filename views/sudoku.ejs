<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sudoku - GameHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="/css/main.css" rel="stylesheet">
    <link href="/css/sudoku.css" rel="stylesheet">
    <link href="/css/invitations.css" rel="stylesheet">
</head>
<body class="gh-page">
    <%- include('partials/navbar', { user: user }) %>
    <%- include('partials/alert') %>
    <%- include('partials/invitation-notification') %>

    <main class="container py-4">
        <div class="text-center mb-4">
            <h1 class="gh-game-title">Sudoku</h1>
            <p class="text-muted mb-0">
                Remplissez la grille 9x9. Chaque ligne, colonne et bloc 3x3
                doit contenir tous les chiffres de 1 a 9.
            </p>
        </div>

        <div id="status" class="alert d-none mx-auto" role="alert"></div>

        <div id="board" class="sudoku-board mx-auto" aria-label="Grille de Sudoku"></div>

        <div class="text-center mt-4">
            <button id="btn-new" class="btn btn-primary m-1">
                Nouvelle partie
            </button>
            <button id="btn-submit" class="btn btn-success m-1">
                Verifier
            </button>
            <button id="btn-solve" class="btn btn-warning m-1">
                Solution
            </button>
            <button id="btn-clear" class="btn btn-secondary m-1">
                Effacer
            </button>
        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>
    <script src="/js/sudoku.js"></script>
    <script src="/js/invitation-notifications.js"></script>
</body>
</html>
