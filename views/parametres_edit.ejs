<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Modifier paramètre</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
</head>
<body class="gh-page">
  <%- include('partials/navbar', { user: currentUser }) %>

  <main class="container py-5">
    <div class="gh-auth-shell mx-auto">
      <section class="gh-auth-card">
        <h1 class="h3 mb-3"><%= label %></h1>

        <form action="/parametres/update" method="post">
          <input type="hidden" name="champ" value="<%= champ %>">

          <% if (champ === 'mot_de_passe') { %>
            <div class="form-group">
              <label>Nouveau mot de passe</label>
              <input name="mot_de_passe" type="password" class="form-control">
            </div>
            <div class="form-group">
              <label>Confirmer</label>
              <input name="mot_de_passe_confirm" type="password" class="form-control">
            </div>
          <% } else if (champ === 'date_naissance') { %>
            <div class="form-group">
              <label>Valeur</label>
              <input name="value" type="date" class="form-control" value="<%= value || '' %>">
            </div>
          <% } else { %>
            <div class="form-group">
              <label>Valeur</label>
              <input name="value" class="form-control" value="<%= value || '' %>">
            </div>
          <% } %>

          <div class="d-flex">
            <button class="btn btn-primary mr-2">Enregistrer</button>
            <a class="btn btn-secondary" href="/parametres">Annuler</a>
          </div>
        </form>

      </section>
    </div>
  </main>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/js/navbar.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>
</body>
</html>
