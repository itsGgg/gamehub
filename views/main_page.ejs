<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GameHub - Jeux de plateau en ligne</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="/css/main.css" rel="stylesheet">
    <link href="/css/invitations.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar', { user: user }) %>
    <%- include('partials/alert') %>
    <%- include('partials/invite-modal') %>
    <%- include('partials/players-sidebar') %>
    <% if (user) { %>
        <%- include('partials/invitation-notification') %>
    <% } %>
    <header class="gh-hero">
        <div class="container text-white text-center py-5">
            <h1 class="display-3 font-weight-bold mb-3">GameHub</h1>
            <p class="lead mb-4">
                Affrontez d'autres joueurs sur vos jeux de plateau preferes,
                directement depuis votre navigateur.
            </p>
            <% if (user) { %>
                <p class="h5 mb-4">Bon retour, <%= user.username %>.</p>
                <a href="#games" class="btn btn-lg btn-light">
                    Choisir un jeu
                </a>
            <% } else { %>
                <a href="/inscription" class="btn btn-lg btn-light mr-2">
                    Creer un compte
                </a>
                <a href="/connexion" class="btn btn-lg btn-outline-light">
                    Se connecter
                </a>
            <% } %>
        </div>
        <div class="gh-hero-wave"></div>
    </header>

    <section class="container py-5">
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="gh-feature">
                    <div class="gh-feature-icon">1</div>
                    <h5>Inscrivez-vous</h5>
                    <p class="text-muted">
                        Creez un compte en quelques secondes pour rejoindre la communaute.
                    </p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="gh-feature">
                    <div class="gh-feature-icon">2</div>
                    <h5>Trouvez un adversaire</h5>
                    <p class="text-muted">
                        Parcourez la liste des joueurs en ligne et invitez celui de votre choix.
                    </p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="gh-feature">
                    <div class="gh-feature-icon">3</div>
                    <h5>Jouez et discutez</h5>
                    <p class="text-muted">
                        Une partie, un chat integre, et a vous la victoire.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section id="games" class="gh-games-section py-5">
        <div class="container">
            <h2 class="text-center mb-2">Nos jeux</h2>
            <p class="text-center text-muted mb-5">
                Choisissez un jeu et lancez-vous.
            </p>

            <% if (!games || games.length === 0) { %>
                <p class="text-center text-muted">
                    Aucun jeu disponible pour le moment.
                </p>
            <% } else { %>
                <div class="row">
                    <% games.forEach(function (g) { %>
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card gh-game-card h-100 shadow-sm">
                                <div class="gh-game-thumb gh-game-<%= g.name %>">
                                    <span class="gh-game-label text-capitalize">
                                        <%= g.name %>
                                    </span>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <p class="card-text flex-grow-1">
                                        <%= g.description %>
                                    </p>
                                    <% if (g.name === 'sudoku') { %>
                                        <% if (user) { %>
                                            <a href="/jeux/sudoku"
                                               class="btn btn-primary mt-3">
                                                Jouer
                                            </a>
                                        <% } else { %>
                                            <a href="/connexion"
                                               class="btn btn-outline-primary mt-3">
                                                Connectez-vous pour jouer
                                            </a>
                                        <% } %>
                                    <% } else if (user) { %>
                                        <button type="button"
                                                class="btn btn-primary mt-3 js-open-players"
                                                data-game-id="<%= g.id %>"
                                                data-game-name="<%= g.name %>">
                                            Trouver un adversaire
                                        </button>
                                    <% } else { %>
                                        <a href="/connexion"
                                           class="btn btn-outline-primary mt-3">
                                            Connectez-vous pour jouer
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </section>

    <footer class="gh-footer text-center py-4">
        <small>L3 Informatique &middot; Programmation Web 2025-2026</small>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/navbar.js"></script>
    <script src="/js/invitations.js"></script>
    <% if (user) { %>
        <script src="/js/invitation-notifications.js"></script>
    <% } %>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>
</body>
</html>
